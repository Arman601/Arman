
public class reverse {

    public static void main(String[] args) {
        String name = "TAHSEN";
        int len = name.length();
        String rev = "";
        for (int i = len - 1; i >= 0; i--) {
            rev = rev + name.charAt(i);
        }
        System.out.println("The Original String = " + name);
        System.out.println("The reversed String  = " + rev);

    }
}
